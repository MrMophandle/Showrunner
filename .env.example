# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
# Read automatically by `npm start`, `npm run dev`, and `docker compose up`.
# Leave ANTHROPIC_API_KEY unset to fall back to the `claude` CLI (D6's other backend),
# which works outside the container where you're signed in.

ANTHROPIC_API_KEY=

# Optional — force a backend instead of letting choose.ts decide.
# One of: anthropic-api | claude-cli
SHOWRUNNER_LLM_BACKEND=
