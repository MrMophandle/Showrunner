{
  "name": "showrunner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning app/server/index.ts",
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning app/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "npm test && npm run typecheck",
    "fixture:load": "node --disable-warning=ExperimentalWarning app/server/fixture/cli.ts",
    "smoke:llm": "node --disable-warning=ExperimentalWarning scripts/smoke-llm.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
