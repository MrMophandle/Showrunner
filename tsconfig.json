{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // The server runs its TypeScript under Node's type stripping, which only erases.
    // Enums, parameter properties, and namespaces would typecheck and then fail to
    // boot, so they have to be a typecheck error instead.
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["app", "scripts", "vite.config.ts", "vitest.config.ts"]
}
